{
  "name": "n02-train-manager",
  "version": "1.0.0",
  "description": "N02 Limited Express Train Manager — Express backend serving rail/station data + static frontend",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test",
    "lint": "node scripts/check-source.mjs && node scripts/check-undefined-globals.mjs",
    "precompute": "node scripts/precompute-train-parts.mjs",
    "precompute:tw": "PRECOMPUTE_COUNTRY=tw PRECOMPUTE_STORE=data/train-store-tw.json PRECOMPUTE_OUT_DIR=data/sample-data-tw node scripts/precompute-train-parts.mjs",
    "generate:new-year-grand-loop": "node scripts/generate-new-year-grand-loop.mjs",
    "precompute:new-year-grand-loop": "npm run generate:new-year-grand-loop && PRECOMPUTE_STORE=data/special-samples/new-year-grand-loop.json PRECOMPUTE_OUT_DIR=data/new-year-grand-loop-data node scripts/precompute-train-parts.mjs",
    "generate:tokyo-limited-express-loop": "node scripts/generate-tokyo-limited-express-loop.mjs",
    "precompute:tokyo-limited-express-loop": "npm run generate:tokyo-limited-express-loop && PRECOMPUTE_STORE=data/special-samples/tokyo-limited-express-loop.json PRECOMPUTE_OUT_DIR=data/tokyo-limited-express-loop-data node scripts/precompute-train-parts.mjs",
    "update:july-22-23": "node scripts/update-july-22-23-itinerary.mjs",
    "update:august-2:tw": "node scripts/add-august-2-taipei-metro-itinerary.mjs",
    "update:august-5-6:tw": "node scripts/add-august-5-6-taiwan-itinerary.mjs",
    "update:august-8-9:tw": "node scripts/add-august-8-9-taiwan-itinerary.mjs",
    "normalize:companies:tw": "node scripts/normalize-taiwan-company-names.mjs",
    "build:static": "node scripts/build-static-site.mjs",
    "serve:static": "node scripts/serve-static.mjs",
    "dev:static": "npm run build:static && node scripts/serve-static.mjs",
    "build": "npm run precompute && npm run precompute:tw && npm run precompute:new-year-grand-loop && npm run precompute:tokyo-limited-express-loop && npm run build:static"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0"
  }
}
