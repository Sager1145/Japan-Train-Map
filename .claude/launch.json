{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "train-map",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:static"],
      "cwd": "app",
      "port": 4000,
      "autoPort": true
    },
    {
      "name": "train-map-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "cwd": "app",
      "port": 3000,
      "autoPort": true
    }
  ]
}
