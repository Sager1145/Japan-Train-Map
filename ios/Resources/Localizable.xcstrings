    "disp.fitCurveOverlapNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitted curves only cover overlapping corridors (track shared by multiple trains); non-overlapping routes produce no curve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィッティング曲線は重複区間（複数列車が共有する線路）のみが対象です。重複のない路線には生成されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拟合曲线仅涵盖重叠区间（多列车共线的走廊）；未重叠的路线不会产生曲线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擬合曲線僅涵蓋重疊區間（多列車共線的走廊）；未重疊的路線不會產生曲線。"
          }
        }
      }
    },
    "disp.fitCurvePendingHint" : {
