    "disp.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After changing a fit slider, press Rebuild Fitted Curves to apply it. A large detail scale can turn dense bends into a straight span or smooth arc. Cyan shows the pick box, orange the hold radius, and magenta the interval-switch zone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィッティング設定はスライダー変更後に「フィッティング曲線を再構築」を押すと適用されます。ディテール尺度を大きくすると密集した折れを直線または滑らかな弧にできます。シアンはヒット領域、オレンジは一時保持範囲、マゼンタは区間切替範囲です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拟合参数拖动后，须按「重建拟合曲线」才会应用。大细节尺度可把密集拐点拉成直线或平滑弧线；青色为命中框、橙色为暂留范围、洋红为区间切换范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擬合參數拖動後，須按「重建擬合曲線」才會套用。大細節尺度可把密集拐點拉成直線或平滑弧線；青色為命中框、橙色為暫留範圍、洋紅為區間切換範圍。"
          }
        }
      }
    },
