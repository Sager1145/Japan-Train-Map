# OS / Python artifacts
.DS_Store
__pycache__/

# Installed dependencies are recreated from package-lock.json.
app/node_modules/

app/data/*.json.gz

# Precomputed sample data (manifest + one JSON per train, ~8 MB).
# Regenerated from train-store.json by app/scripts/build/precompute-train-parts.mjs —
# the Pages deploy workflow runs it on every push, so the output is never
# committed. Run it manually for local static-build testing.
app/data/sample-data/
app/data/sample-data-tw/
app/data/sample-data-hk/
app/data/sample-data-mo/
app/data/sample-data-kr/

# Same deal for the special-sample loops: the stores in app/data/special-samples/
# ARE committed (they are the source, written by scripts/generate-*-loop.mjs),
# but their precomputed parts are regenerated by the deploy workflow.
# Local static-build testing: npm run precompute:new-year-grand-loop and
# npm run precompute:tokyo-limited-express-loop.
app/data/new-year-grand-loop-data/
app/data/tokyo-limited-express-loop-data/

# Precompute publishes by swapping a staging directory onto the output path,
# so "<out-dir>.staging" exists for the length of a solve and "<out-dir>.previous"
# for the length of the swap. Both are removed on success and on a handled
# failure; a hard kill can leave one behind.
app/data/*.staging/
app/data/*.previous/

# Lazily generated gzip sidecars for large static assets (rail package, basemap,
# logo credits). Regenerated on demand by server.js; never committed.
app/public/**/*.json.gz

# Perf-work scratch: pre-edit backups + a one-off failure-analysis script.
# Safe to delete once the optimizations are verified.
app/.perf-backup/
app/data/analyze-failures.js
app/public/**/*.js.gz
app/public/**/*.css.gz
app/shared/**/*.js.gz

# Static GitHub Pages build output. The glob also covers the numbered copies
# ("_site 10/", "_site 42/" …) that accumulate when the bundle is duplicated
# rather than rebuilt in place — they are the same disposable artifact.
_site/
_site*/

# Pre-edit data snapshots (e.g. train-store.pre-readings.bak.json). Working
# artifacts kept locally for rollback; never committed.
*.bak.json

# Local output directory for reports and dumps
outputs/

# Apple Maps transit survey (app/data/raw/railway/jp/apple-maps/).
# 2,417 full-screen captures of Apple Maps in transit mode covering Hokkaido,
# Honshu, Shikoku and Kyushu at three zoom levels — 11 GB of PNG. Source
# imagery rather than derived data, and reproducible: 3-RUN-CAPTURE.command
# replays the whole survey from tiles/*.tsv in ~1h45m and resumes if stopped.
app/data/raw/railway/jp/apple-maps/out/

# Calibration captures used to measure Apple's zoom-to-ground-scale mapping.
# Kept locally as evidence for the constants in stitch.py; ~190 MB, not needed
# to rebuild anything.
app/data/raw/railway/jp/apple-maps/_calib/
app/data/raw/railway/jp/apple-maps/_calib2/

# Stitched mosaics, rebuilt from the tiles by stitch.py / fullres_png.py.
# japan_z2_FULLRES.png alone is 453 MB (2.85 gigapixels) — well past GitHub's
# 100 MB per-file limit, and this repo has no LFS configured.
app/data/raw/railway/jp/apple-maps/mosaics/

# Transport archives used to move the survey onto this machine.
app/data/raw/railway/jp/apple-maps/*.zip

# NOTE: tiles/*.tsv (the capture grids) and manifests/*.csv (per-tile lat/lon
# and N/S/E/W bounds) ARE committed. They are small, they define the survey,
# and stitch.py needs them to place every tile.

# Staged-rebuild scratch. Country builders write WHOLE packages here; only
# scripts/railway/promote-lines.mjs writes public/rail/*.json, one session's
# lines at a time (RAILWAY_REBUILD_SESSION_PLAN.md S01).
app/data/staging/

# Scratch: transport archives, applied-patch snapshots and staging copies moved
# through here by hand. 245 MB and none of it reproduces anything.
tmp/

# Duplicates of app/data/raw/railway/jp/rebuild-inventory/, which IS committed.
# `classification/` is the same tables under their pre-organisation names and
# `backup-n02-.../` is a snapshot taken before the 2026-08-13 corrections were
# applied; together 277 MB of second copies.
app/data/raw/railway/jp/classification/
app/data/raw/railway/jp/backup-n02-2025-baseline-20260813/

# Transport archive of the directory committed beside it.
app/data/raw/railway/hk/rebuild-inventory.zip

# Agent worktrees: real git checkouts, so an unqualified `git add` picks them
# up as embedded repositories.
.claude/worktrees/
