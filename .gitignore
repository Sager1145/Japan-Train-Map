# OS / Python artifacts
.DS_Store
__pycache__/

# Installed dependencies are recreated from package-lock.json.
app/node_modules/

app/data/*.json.gz

# Precomputed sample data (manifest + one JSON per train, ~8 MB).
# Regenerated from train-store.json by app/scripts/precompute-train-parts.mjs —
# the Pages deploy workflow runs it on every push, so the output is never
# committed. Run it manually for local static-build testing.
app/data/sample-data/
app/data/sample-data-tw/
app/data/sample-data-hk/
app/data/sample-data-mo/

# Same deal for the special-sample loops: the stores in app/data/special-samples/
# ARE committed (they are the source, written by scripts/generate-*-loop.mjs),
# but their precomputed parts are regenerated by the deploy workflow.
# Local static-build testing: npm run precompute:new-year-grand-loop and
# npm run precompute:tokyo-limited-express-loop.
app/data/new-year-grand-loop-data/
app/data/tokyo-limited-express-loop-data/

# Precompute publishes by swapping a staging directory onto the output path,
# so "<out-dir>.staging" exists for the length of a solve and "<out-dir>.previous"
# for the length of the swap. Both are removed on success and on a handled
# failure; a hard kill can leave one behind.
app/data/*.staging/
app/data/*.previous/

# Lazily generated gzip sidecars for large static assets (rail package, basemap,
# logo credits). Regenerated on demand by server.js; never committed.
app/public/**/*.json.gz

# Perf-work scratch: pre-edit backups + a one-off failure-analysis script.
# Safe to delete once the optimizations are verified.
app/.perf-backup/
app/data/analyze-failures.js
app/public/**/*.js.gz
app/public/**/*.css.gz

# Static GitHub Pages build output. The glob also covers the numbered copies
# ("_site 10/", "_site 42/" …) that accumulate when the bundle is duplicated
# rather than rebuilt in place — they are the same disposable artifact.
_site/
_site*/

# Pre-edit data snapshots (e.g. train-store.pre-readings.bak.json). Working
# artifacts kept locally for rollback; never committed.
*.bak.json

# Local output directory for reports and dumps
outputs/
